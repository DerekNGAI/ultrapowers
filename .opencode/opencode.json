{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["../index.js"],
  "instructions": [".opencode/instructions/dual-review.md"],
  "agent": {
    "ultrapowers-reviewer": {
      "mode": "primary",
      "description": "Review agent for checking code quality, architecture, and risks.",
      "prompt": "{file:prompts/reviewer.md}"
    },
    "ultrapowers-planner": {
      "mode": "primary",
      "description": "Splits large tasks into self-contained parallel implementation plans with isolated Git worktrees, staged integration, and cleanup.",
      "prompt": "{file:prompts/parallel-planner.md}",
      "permission": {
        "*": "deny",
        "external_directory": "ask",
        "edit": {
          "*": "deny",
          ".opencode/plans/**/*.md": "allow"
        },
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "context7_*": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "*": "deny",
          "git rev-parse --show-toplevel": "allow",
          "git rev-parse --verify HEAD": "allow",
          "git symbolic-ref --short HEAD": "allow",
          "git status --short --untracked-files=all": "allow",
          "git diff --no-ext-diff --no-textconv --binary --cached": "allow",
          "git diff --no-ext-diff --no-textconv --binary": "allow",
          "git ls-files --stage": "allow",
          "git worktree list --porcelain": "allow"
        }
      }
    },
    "ultrapowers-judge": {
      "mode": "primary",
      "description": "Plans work, delegates implementation to general, and judges two independent reviewers through a bounded dual-review loop.",
      "prompt": "{file:prompts/dual-judge.md}",
      "permission": {
        "*": "deny",
        "edit": "deny",
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "general": "allow",
          "ultrapowers-reviewer-a": "allow",
          "ultrapowers-reviewer-b": "allow"
        }
      }
    },
    "ultrapowers-reviewer-a": {
      "mode": "subagent",
      "description": "Independent read-only reviewer A, emphasizing correctness, regressions, and affected callers. Returns evidence and stable finding IDs.",
      "prompt": "You are reviewer A. Use IDs A-001 onward. Emphasize correctness, regressions, and affected callers; report any evidenced defect.\n\n{file:prompts/dual-reviewer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "ultrapowers-reviewer-b": {
      "mode": "subagent",
      "description": "Independent read-only reviewer B, emphasizing failure paths, security, and integration behavior. Returns evidence and stable finding IDs.",
      "prompt": "You are reviewer B. Use IDs B-001 onward. Emphasize failure paths, security, and integration behavior; report any evidenced defect.\n\n{file:prompts/dual-reviewer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "ultrapowers-committer": {
      "mode": "primary",
      "description": "Asks how to commit completed changes, then creates Conventional Commits on the current branch or independent branches with draft PRs.",
      "steps": 50,
      "prompt": "{file:prompts/committer.md}",
      "permission": {
        "*": "deny",
        "external_directory": "allow",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "*.p12": "deny",
          "*.pfx": "deny",
          "*id_rsa": "deny",
          "*id_ed25519": "deny",
          "*credentials.json": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "allow",
        "question": "allow",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git status *": "allow",
          "git rev-parse *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git show-ref *": "allow",
          "git symbolic-ref HEAD": "allow",
          "git symbolic-ref --short HEAD": "allow",
          "git check-ref-format *": "allow",
          "git hash-object *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git ls-files *": "allow",
          "git ls-tree *": "allow",
          "git ls-remote *": "allow",
          "git branch *-d*": "ask",
          "git branch *-D*": "ask",
          "git branch": "allow",
          "git branch --list *": "allow",
          "git branch -l *": "allow",
          "git branch --show-current": "allow",
          "git remote get-url origin": "allow",
          "git remote get-url *": "allow",
          "git fetch --no-tags origin refs/heads/*:refs/remotes/origin/*": "allow",
          "git fetch --no-tags origin 'refs/heads/*:refs/remotes/origin/*'": "allow",
          "git fetch --no-tags origin \"refs/heads/*:refs/remotes/origin/*\"": "allow",
          "git fetch origin *": "allow",
          "git fetch * origin *": "allow",
          "git checkout -b *": "allow",
          "git switch -- *": "allow",
          "git switch *": "allow",
          "git add -- *": "allow",
          "git apply": "deny",
          "git apply *": "deny",
          "git commit --file=-*": "allow",
          "git commit *": "allow",
          "git push -u origin refs/heads/*:refs/heads/*": "allow",
          "git push -u origin 'refs/heads/*:refs/heads/*'": "allow",
          "git push -u origin \"refs/heads/*:refs/heads/*\"": "allow",
          "git push origin *": "allow",
          "git push * origin *": "allow",
          "gh --version": "allow",
          "gh auth status": "allow",
          "gh auth status *": "allow",
          "gh repo view *": "allow",
          "gh pr create --draft *": "allow",
          "gh pr create *": "allow",
          "gh pr view *": "allow",
          "gh pr list *": "allow",
          "gh pr status *": "allow",
          "gh pr diff *": "allow",
          "gh pr checks *": "allow",
          "git reset *": "deny",
          "git reset": "allow",
          "git restore *": "deny",
          "git clean *": "deny",
          "git checkout -- *": "deny",
          "git checkout -B *": "deny",
          "git switch -C*": "deny",
          "git switch * -C*": "deny",
          "git switch *--force-create*": "deny",
          "git switch *--discard-changes*": "deny",
          "git switch *--orphan*": "deny",
          "git switch -f*": "deny",
          "git switch * -f*": "deny",
          "git branch -d *": "deny",
          "git branch -D *": "deny",
          "git branch --delete *": "deny",
          "git branch * -d *": "deny",
          "git branch * -D *": "deny",
          "git branch * --delete *": "deny",
          "git commit *--amend*": "deny",
          "git commit *--no-verify*": "deny",
          "git commit * -n*": "deny",
          "git commit --amend *": "deny",
          "git commit * --amend *": "deny",
          "git commit --no-verify *": "deny",
          "git commit * --no-verify *": "deny",
          "git commit -n*": "deny",
          "git commit * -n *": "deny",
          "git commit * -n?*": "deny",
          "git push *--force*": "deny",
          "git push * -f*": "deny",
          "git push --force*": "deny",
          "git push * --force*": "deny",
          "git push -f*": "deny",
          "git push * -f *": "deny",
          "git push * -f?*": "deny",
          "git push --no-verify *": "deny",
          "git push * --no-verify *": "deny",
          "git push *--delete*": "deny",
          "git push -d *": "deny",
          "git push * -d *": "deny",
          "git push *--mirror*": "deny",
          "git push *--all*": "deny",
          "git push * :*": "deny",
          "git push * ':*": "deny",
          "git push * \":*": "deny",
          "git push * +*": "deny",
          "git push * '+*": "deny",
          "git push * \"+*": "deny",
          "git config *": "deny",
          "git -c *": "deny",
          "ssh *": "deny",
          "ssh -G *": "allow",
          "git commit --file=- <<'ULTRAPOWERS_COMMIT_MESSAGE'\n*": "allow",
          "git apply --cached --check <<'ULTRAPOWERS_COMMIT_PATCH'\n*": "allow",
          "git apply --cached <<'ULTRAPOWERS_COMMIT_PATCH'\n*": "allow",
          "git commit --file=- <<'*'\n*": "allow",
          "git apply --cached --check <<'*'\n*": "allow",
          "git apply --cached <<'*'\n*": "allow"
        }
      }
    }
  },
  "command": {
    "parallel-plan": {
      "agent": "ultrapowers-planner",
      "subtask": false,
      "description": "Write independent task plans for parallel worktrees and a final plan that stages integration on the original branch and cleans up.",
      "template": "Create a persistent parallel implementation plan using the planner workflow. Write self-contained worker plans and a final integration plan; the user will assign them to separate implementation sessions. Final integration must leave the combined changes staged on the original branch for the user to review and commit, and clean up this job's worktrees.\nTask: $ARGUMENTS"
    },
    "dual-review": {
      "agent": "ultrapowers-judge",
      "subtask": false,
      "description": "Review the current change with two independent model families, judge findings, delegate valid fixes to general, and stop within three rounds.",
      "template": "Review the current project changes using the shared dual-review protocol.\nAdditional scope or focus: $ARGUMENTS"
    },
    "commit": {
      "agent": "ultrapowers-committer",
      "subtask": false,
      "description": "Choose local commits on the current branch or independent branches with draft PRs, with or without an issue prefix.",
      "template": "First use the question tool to ask which commit mode the user wants. Follow the committer workflow for their choice.\nSuggested prefix (optional): $ARGUMENTS"
    }
  }
}
