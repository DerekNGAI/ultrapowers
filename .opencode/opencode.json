{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["../index.js"],
  "instructions": [".opencode/instructions/dual-review.md"],
  "agent": {
    "ultrapowers-reviewer": {
      "mode": "primary",
      "description": "Review agent for checking code quality, architecture, and risks.",
      "prompt": "{file:prompts/reviewer.md}"
    },
    "ultrapowers-judge": {
      "mode": "primary",
      "description": "Plans work, delegates implementation to general, and judges two independent reviewers through a bounded dual-review loop.",
      "steps": 80,
      "prompt": "{file:prompts/dual-judge.md}",
      "permission": {
        "*": "deny",
        "edit": "deny",
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "question": "allow",
        "bash": {
          "*": "deny",
          "git rev-parse --show-toplevel": "allow",
          "git rev-parse HEAD": "allow",
          "git rev-parse --verify HEAD": "allow",
          "git status --short --untracked-files=all": "allow",
          "git diff --no-ext-diff --no-textconv --binary --cached": "allow",
          "git diff --no-ext-diff --no-textconv --binary": "allow",
          "git hash-object -- *": "allow",
          "git ls-files --others --exclude-standard": "allow",
          "git ls-files --others --exclude-standard -z": "allow"
        },
        "task": {
          "*": "deny",
          "general": "allow",
          "ultrapowers-reviewer-a": "allow",
          "ultrapowers-reviewer-b": "allow"
        }
      }
    },
    "ultrapowers-reviewer-a": {
      "mode": "subagent",
      "description": "Independent read-only reviewer A, emphasizing correctness, regressions, and affected callers. Returns evidence and stable finding IDs.",
      "steps": 30,
      "prompt": "You are reviewer A. Use IDs A-001 onward. Emphasize correctness, regressions, and affected callers; report any evidenced defect.\n\n{file:prompts/dual-reviewer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "ultrapowers-reviewer-b": {
      "mode": "subagent",
      "description": "Independent read-only reviewer B, emphasizing failure paths, security, and integration behavior. Returns evidence and stable finding IDs.",
      "steps": 30,
      "prompt": "You are reviewer B. Use IDs B-001 onward. Emphasize failure paths, security, and integration behavior; report any evidenced defect.\n\n{file:prompts/dual-reviewer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "ultrapowers-committer": {
      "mode": "primary",
      "description": "Asks how to commit completed changes, then creates Conventional Commits on the current branch or independent branches with draft PRs.",
      "steps": 50,
      "prompt": "{file:prompts/committer.md}",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "*.p12": "deny",
          "*.pfx": "deny",
          "*id_rsa": "deny",
          "*id_ed25519": "deny",
          "*credentials.json": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "allow",
        "question": "allow",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git status *": "allow",
          "git rev-parse *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git hash-object *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git ls-files *": "allow",
          "git ls-tree *": "allow",
          "git remote get-url origin": "allow",
          "git fetch --no-tags origin refs/heads/*:refs/remotes/origin/*": "allow",
          "git fetch --no-tags origin 'refs/heads/*:refs/remotes/origin/*'": "allow",
          "git fetch --no-tags origin \"refs/heads/*:refs/remotes/origin/*\"": "allow",
          "git checkout -b *": "allow",
          "git switch -- *": "allow",
          "git add -- *": "allow",
          "git reset": "allow",
          "git commit --file=-*": "allow",
          "git push -u origin refs/heads/*:refs/heads/*": "allow",
          "git push -u origin 'refs/heads/*:refs/heads/*'": "allow",
          "git push -u origin \"refs/heads/*:refs/heads/*\"": "allow",
          "gh --version": "allow",
          "gh auth status": "allow",
          "gh repo view *": "allow",
          "gh pr create --draft *": "allow",
          "git reset *": "deny",
          "git restore *": "deny",
          "git clean *": "deny",
          "git checkout -- *": "deny",
          "git branch *-d*": "deny",
          "git branch *-D*": "deny",
          "git commit *--amend*": "deny",
          "git commit *--no-verify*": "deny",
          "git commit * -n*": "deny",
          "git push *--force*": "deny",
          "git push * -f*": "deny",
          "git config *": "deny",
          "git -c *": "deny",
          "ssh *": "deny",
          "ssh -G *": "allow",
          "git commit --file=- <<'ULTRAPOWERS_COMMIT_MESSAGE'\n*": "allow"
        }
      }
    }
  },
  "command": {
    "dual-review": {
      "agent": "ultrapowers-judge",
      "subtask": false,
      "description": "Review the current change with two independent model families, judge findings, delegate valid fixes to general, and stop within three rounds.",
      "template": "Review the current project changes using the shared dual-review protocol.\nAdditional scope or focus: $ARGUMENTS"
    },
    "commit": {
      "agent": "ultrapowers-committer",
      "subtask": false,
      "description": "Choose local commits on the current branch or independent branches with draft PRs, with or without an issue prefix.",
      "template": "First use the question tool to ask which commit mode the user wants. Follow the committer workflow for their choice.\nSuggested prefix (optional): $ARGUMENTS"
    }
  }
}
